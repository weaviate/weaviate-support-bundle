# lib/jq/summary.jq: render SUMMARY.md from the facts object and findings.
#
# SUMMARY.md is for people: short tables, plain words, and a pointer to the
# file that holds the detail. Everything here is derived from files in the
# bundle, so nothing in it is new information.

include "findings";

def cell: if . == null then "–" else tostring | gsub("\\|"; "\\|") | gsub("\n"; " ") end;
def row: "| " + (map(cell) | join(" | ")) + " |";
def table($head; $rows):
  if ($rows | length) == 0 then "_Nothing to show._"
  else ([($head | row), ($head | map("---") | row)] + ($rows | map(row))) | join("\n") end;

def thousands: if . == null then null
  else (tostring | split(".")[0]) as $s
  | [range(0; $s | length)] | map($s[.:.+1]) as $c
  | reduce range(0; $c | length) as $i (""; . + (if $i > 0 and (($c | length) - $i) % 3 == 0 then "," else "" end) + $c[$i]) end;

def mib: if . == null then null else "\((. / 1048576) | round) MiB" end;
def gib: if . == null then null else "\((. / 1073741824 * 10 | round) / 10) GiB" end;

# Compression of one vector index config.
def compression:
  if . == null then null else
    [ (if .pq.enabled == true then "PQ" else empty end),
      (if .bq.enabled == true then "BQ" else empty end),
      (if .sq.enabled == true then "SQ" else empty end),
      (if .rq.enabled == true then "RQ\(if .rq.bits then "-\(.rq.bits)" else "" end)" else empty end) ]
    | if length == 0 then "none" else join("+") end
  end;

def index_desc($type; $cfg):
  if $type == "dynamic" then "dynamic (hnsw: \($cfg.hnsw | compression), flat: \($cfg.flat | compression))"
  else "\($type // "?")" end;

def vectors_of:
  if (.config.vectorConfig // {} | length) > 0 then
    [.config.vectorConfig | to_entries[] | {name: .key, type: .value.vectorIndexType, cfg: .value.vectorIndexConfig,
       vectorizer: (.value.vectorizer // {} | keys[0] // "none")}]
  else
    [{name: "(default)", type: .config.vectorIndexType, cfg: .config.vectorIndexConfig, vectorizer: (.config.vectorizer // "none")}]
  end;

def key_settings:
  ["GOMEMLIMIT", "LIMIT_RESOURCES", "GOMAXPROCS", "ASYNC_INDEXING", "PERSISTENCE_DATA_PATH",
   "PERSISTENCE_LSM_ACCESS_STRATEGY", "DISK_USE_WARNING_PERCENTAGE", "DISK_USE_READONLY_PERCENTAGE",
   "MEMORY_WARNING_PERCENTAGE", "MEMORY_READONLY_PERCENTAGE", "RAFT_JOIN", "RAFT_BOOTSTRAP_EXPECT",
   "REPLICATION_MINIMUM_FACTOR", "ASYNC_REPLICATION_DISABLED", "DISABLE_LAZY_LOAD_SHARDS",
   "ENABLE_MODULES", "DEFAULT_VECTORIZER_MODULE", "AUTOSCHEMA_ENABLED", "QUERY_SLOW_LOG_ENABLED",
   "PROMETHEUS_MONITORING_ENABLED", "AUTHENTICATION_APIKEY_ENABLED", "AUTHENTICATION_OIDC_ENABLED",
   "AUTHORIZATION_RBAC_ENABLED", "AUTHORIZATION_ADMINLIST_ENABLED", "RUNTIME_OVERRIDES_ENABLED"];

def sev_icon: {"high": "🔴 HIGH", "warn": "🟠 WARN", "info": "🔵 INFO"}[.];

def summary($facts; $findings):
  ($facts.manifest) as $m
  | ($facts.nodes.nodes // []) as $wn
  | ($facts.collections // []) as $cols
  | [
  "# Weaviate support bundle",
  "",
  "Generated by \($m.tool.name) \($m.tool.version) at \($m.created_at). Start here, then follow the file links.",
  "",
  table(["", ""]; [
    ["Kubernetes", "context `\($m.target.context)` · \($facts.cluster.kubernetes_version // "?") · namespace `\($m.target.namespace)` · StatefulSet `\($m.target.statefulset)`"],
    ["Weaviate", "\(if $facts.meta then "v\($facts.meta.version)" else "version unknown" end) · \($wn | length) node(s) · image `\($facts.env.image // "?")`"],
    ["Collections", (if $facts.collections == null then "not collected" else
        "\($cols | length) (\([$cols[] | select(.config.multiTenancyConfig.enabled == true)] | length) multi-tenant) · about \(([$wn[].stats.objectCount // 0] | add // 0) | thousands) objects incl. replicas · \(([$wn[].stats.shardCount // 0] | add // 0)) shard replicas" end)],
    ["Logs", ($m.run.log_window)],
    ["Anonymized", (if $m.run.anonymized then "yes: tenant and user names replaced" else "no" end)]
  ]),
  "",
  "## Red flags",
  "",
  (if ($findings | length) == 0 then "No red flags found in the collected data."
   else ($findings | map("- **\(.severity | sev_icon)** \(.title)\(if (.detail // "") != "" then ": \(.detail)" else "" end) ([`\(.file)`](\(.file)))") | join("\n")) end),
  "",
  "## Weaviate nodes",
  "",
  (if $facts.nodes == null then "_Not collected (see “What was not collected”)._" else
    table(["Node", "Status", "Version", "Mode", "Objects (approx.)", "Shards", "Vector queue"];
      [$wn[] | [.name, .status, .version, .operationalMode, (.stats.objectCount | thousands), .stats.shardCount,
                ([.shards[]?.vectorQueueLength // 0] | add // 0 | thousands)]]) +
    "\n\nObject counts come from /v1/nodes, which Weaviate updates in the background: very recent writes may not be counted yet." end),
  "",
  "## Raft (cluster metadata)",
  "",
  (if $facts.raft == null then "_Not collected._" else
    "Synchronized: **\($facts.raft.synchronized)**\n\n" +
    table(["Node", "Status", "Raft state", "Voter", "Ready", "DB loaded", "Leader", "Term", "Applied index"];
      [$facts.raft.statistics[]? | [.name, .status, .raft.state, .isVoter, .ready, .dbLoaded, (.leaderId // null),
                                    .raft.term, (.raft.appliedIndex // .lastAppliedIndex)]]) end),
  "",
  "## Pods",
  "",
  (if $facts.pods == null then "_Not collected._" else
    table(["Pod", "Phase", "Ready", "Restarts", "Last exit", "Node", "CPU req / limit", "Memory req / limit", "QoS"];
      [($facts.pods.weaviate + $facts.pods.modules)[] | . as $p
       | ([.containerStatuses[]? | .restartCount] | add // 0) as $r
       | ([.containerStatuses[]? | .lastState.terminated | select(. != null) | "\(.reason) (\(.exitCode)) \(.finishedAt)"] | first) as $last
       | ([.containers[0].resources.requests.cpu, .containers[0].resources.limits.cpu] | map(. // "–") | join(" / ")) as $cpu
       | ([.containers[0].resources.requests.memory, .containers[0].resources.limits.memory] | map(. // "–") | join(" / ")) as $mem
       | [.name, .phase, ([.containerStatuses[]? | select(.ready)] | length | tostring) + "/" + (.containers | length | tostring),
          $r, $last, .node, $cpu, $mem, .qosClass]]) end),
  "",
  (if $facts.top != null then "Current usage (metrics-server): " +
     ([$facts.top.pods[] | "`\(.name)` \([.containers[] | "\(.cpu) CPU, \(.memory)"] | join("; "))"] | join(" · ")) + "\n" else empty end),
  "## Disk usage",
  "",
  (if $facts.disk == null then "_Not collected (needs the `nodes/proxy` permission; see docs/permissions.md)._" else
    table(["Pod", "Volume", "Size", "Used", "Free", "Used %"];
      [$facts.disk[] | [.pod, .pvc, (.capacity_bytes | gib), (.used_bytes | gib), (.available_bytes | gib), "\(.used_percent)%"]]) end),
  "",
  "## Collections",
  "",
  (if $facts.collections == null then "_Not collected._" else
    table(["Collection", "Objects incl. replicas (approx.)", "Shards / tenants", "RF", "Async repl.", "Multi-tenant", "Vector index", "Compression", "Distance", "Vectorizer"];
      [$cols[] | . as $c
       | ([$wn[].shards[]? | select(.class == $c.name) | .objectCount // 0] | add // 0) as $objs
       | (if .config.multiTenancyConfig.enabled == true then "\(.tenants.total // "?") tenants" else "\(.config.shardingConfig.desiredCount // .config.shardingConfig.actualCount // "?") shards" end) as $sh
       | vectors_of as $vs
       | [ .name, ($objs | thousands), $sh, (.config.replicationConfig.factor // 1),
           # Since 1.38 async replication is cluster-wide (ASYNC_REPLICATION_DISABLED).
           (if (.config.replicationConfig.factor // 1) <= 1 then "–"
            elif ((($facts.env.env.ASYNC_REPLICATION_DISABLED // "false") | tostring | ascii_downcase) == "true") then "off (cluster)"
            else "on" end),
           (if .config.multiTenancyConfig.enabled == true then
              "yes\(if .config.multiTenancyConfig.autoTenantActivation then ", auto-activation" else "" end)\(if .config.multiTenancyConfig.autoTenantCreation then ", auto-creation" else "" end)"
            else "no" end),
           ($vs | map(if length > 1 or .name != "(default)" then "\(.name): \(index_desc(.type; .cfg))" else index_desc(.type; .cfg) end) | join("; ")),
           ($vs | map(if .type == "dynamic" then "see index" else (.cfg | compression) end) | unique | join("; ")),
           ($vs | map(.cfg.distance // "?") | unique | join("; ")),
           ($vs | map(.vectorizer) | unique | join("; ")) ]]) end),
  "",
  "## Key settings",
  "",
  (if $facts.env == null then "_Not collected._" else
    table(["Setting", "Value"];
      ([["Memory request / limit", "\($facts.env.resources.requests.memory // "–") / \($facts.env.resources.limits.memory // "–")"],
        ["CPU request / limit", "\($facts.env.resources.requests.cpu // "–") / \($facts.env.resources.limits.cpu // "–")"]]
       + [key_settings[] as $k | [$k, (($facts.env.env[$k] // "not set (default)") | if type == "object" then tojson else . end)]])) +
    "\n\nAll settings: [`config/env.json`](config/env.json)" end),
  "",
  (if ($facts.metrics | length) > 0 then
    "## Metrics (\($facts.metrics[0].data.interval_seconds)s window)\n\n" +
    table(["Pod", "Heap in use", "Resident memory", "Goroutines", "Objects", "Vector queue", "Avg query ms", "Avg batch ms"];
      [$facts.metrics[] | .pod as $p | .data as $d | ($d.metrics | map({key: .name, value: .}) | from_entries) as $mm
       | [$p, ($mm.go_memstats_heap_inuse_bytes.t1 | mib), ($mm.process_resident_memory_bytes.t1 | mib), $mm.go_goroutines.t1,
          ($mm.object_count.t1 | thousands), ($mm.queue_size.t1 | thousands),
          $d.latency.queries_durations_ms.avg_in_interval, $d.latency.batch_durations_ms.avg_in_interval]]) + "\n"
   else empty end),
  "## Logs",
  "",
  (if ($facts.logs | length) == 0 then "_No logs collected._" else
    table(["Pod", "Container", "Kind", "Lines", "First line", "Last line", "File"];
      [$facts.logs[] | [.pod, .container, .kind, .lines, .first, .last, "[`\(.file)`](\(.file))\(if .truncated then " (cut at size limit, newest lines kept)" else "" end)\(if .partial then " (partial: reading it stopped early)" else "" end)"]])
    + "\n\nKubernetes keeps only recent logs on each node, so the time covered can be shorter than requested. Previous-container logs (after a restart) hold the last \($m.run.previous_log_lines) lines." end),
  "",
  (if (($m.profiles // []) | length) > 0 then
    "## Profiles\n\n" +
    table(["Pod", "Profile", "Size", "File"];
      [$m.profiles[] | [.pod, .profile, "\(.bytes) B", "[`\(.file)`](\(.file))"]])
    + "\n\nOpen a `.pprof` file with `go tool pprof -http=: <file>`.\n"
   else empty end),
  "## What was not collected",
  "",
  ([$m.steps[] | select(.status != "ok")] as $miss
   | if ($miss | length) == 0 then "Everything was collected."
     else $miss | map("- **\(.section) / \(.name)**: \(.status | gsub("_"; " "))\(if .detail != "" then " (\(.detail))" else "" end)") | join("\n") end),
  "",
  "## Files",
  "",
  "- `findings.json`: the red flags above, machine-readable",
  "- `manifest.json`: what ran, what was skipped and why, tool version",
  "- `redactions.txt`: what was hidden (field names and counts, never values)",
  "- `weaviate/`: API responses: meta, nodes, Raft, collections, replication, backups, tasks, roles",
  "- `kubernetes/`: cluster, nodes, StatefulSet, pods, storage, services, policies, events, config maps",
  "- `config/env.json`: Weaviate's settings (secrets redacted)",
  "- `pods/<pod>/`: status, health, metrics and logs per pod",
  "- `run.log`: what the tool did, step by step",
  ""
  ] | join("\n");
